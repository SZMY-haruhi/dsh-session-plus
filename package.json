{
  "name": "dsh-session-plus",
  "version": "0.1.2",
  "type": "module",
  "description": "DSH session completion: sidebar archive directory, restore, delete, edit-and-resend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SZMY-haruhi/dsh-session-plus.git"
  },
  "bugs": {
    "url": "https://github.com/SZMY-haruhi/dsh-session-plus/issues"
  },
  "homepage": "https://github.com/SZMY-haruhi/dsh-session-plus#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "archive",
    "unarchive"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0 || >=4.0.5-alpha.0 <5.0.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/session-files.test.ts tests/delete-flow.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22.15"
  }
}
